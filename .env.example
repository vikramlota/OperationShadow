# Operation Shadow — Environment Configuration
# TRD v2.0 & Backend/Frontend Architecture

# Safety & Hardware Lockout (MANDATORY: Keep true until hardware failsafes verified)
SHADOW_HARDWARE_LOCKOUT=true
SHADOW_DEFAULT_VEHICLE_MODE=simulated
# Physical serial control stays disabled until an independent motor-stop failsafe is verified.
SHADOW_SCOUT_SERIAL_ENABLED=false
SHADOW_SCOUT_SERIAL_PORT=/dev/ttyUSB0
SHADOW_SCOUT_SERIAL_BAUDRATE=115200
SHADOW_SCOUT_SERIAL_FAILSAFE_VERIFIED=false
# Keep ROSBridge observation ingest disabled while SCOUT01 is under maintenance.
SHADOW_ROSBRIDGE_ENABLED=false

# Shared-secret token for vehicle connections (TRD §5.1, §9)
SHADOW_VEHICLE_SHARED_SECRET=provisional_secret_change_me

# Backend Database & Timing Configuration
SHADOW_DATABASE_URL=sqlite+aiosqlite:///operation_shadow.db
SHADOW_HEARTBEAT_INTERVAL_MS=250
SHADOW_HEARTBEAT_TIMEOUT_MS=1500

# Live Rover ROS 2 Humble ROSBridge Perception Integration (Read-Only; Actuation Remains Locked)
# Vehicle ID must remain unset until explicitly confirmed by the hardware team.
SHADOW_ROS_ENABLED=false
SHADOW_ROS_HOST=
SHADOW_ROS_PORT=9090
SHADOW_ROS_VEHICLE_ID=
SHADOW_ROS_DETECTIONS_TOPIC=/detections_json
SHADOW_ROS_DETECTIONS_MESSAGE_TYPE=std_msgs/msg/String
SHADOW_ROS_DETECTIONS_STALE_AFTER_SECONDS=2.0
# Keep false until TF (map -> odom -> oak_parent_frame) and camera-to-LiDAR extrinsics are validated
SHADOW_ROS_MAP_FRAME_CONFIRMED=false

# Configurable LiDAR Ingestion Settings (Disabled & Unset Until Hardware Team Confirms Topic/Type/Frame)
SHADOW_LIDAR_ENABLED=false
SHADOW_LIDAR_TOPIC=
SHADOW_LIDAR_MESSAGE_TYPE=
SHADOW_LIDAR_FRAME=
SHADOW_LIDAR_STALE_AFTER_SECONDS=2.0
SHADOW_LIDAR_MIN_RANGE_M=0.05
SHADOW_LIDAR_MAX_RANGE_M=30.0

# Camera + LiDAR Multi-Sensor Fusion Thresholds (Extrinsics Unconfirmed By Default)
SHADOW_CAMERA_LIDAR_EXTRINSICS_CONFIRMED=false
SHADOW_FUSION_MAX_TIME_DIFF_SECONDS=0.25
SHADOW_FUSION_ASSOCIATION_DISTANCE_M=0.5
SHADOW_FUSION_CONFLICT_DISTANCE_M=1.2

# LLM Planning Configuration (API key for live Gemini calls; fallback cache used if missing)
GEMINI_API_KEY=
SHADOW_LLM_MODEL=gemini-2.5-flash
SHADOW_LLM_PLANNING_TIMEOUT_SEC=10
SHADOW_LLM_REPLANNING_TIMEOUT_SEC=8
SHADOW_LLM_TRIAGE_TIMEOUT_SEC=3
SHADOW_LLM_CONNECT_TIMEOUT_SEC=3
SHADOW_LLM_BREAKER_COOLDOWN_SEC=30

# Service Ports (HAWK_CAMERA_PORT is simulated / roadmap, not integrated)
SHADOW_BACKEND_PORT=8000
SHADOW_DASHBOARD_PORT=5173
SCOUT_CAMERA_PORT=8081
HAWK_CAMERA_PORT=8082
