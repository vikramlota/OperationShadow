{
  "version": "1.0",
  "standing_orders": [
    {
      "id": "SO-01-CRITICAL-BATTERY",
      "name": "Critical Battery Safe Hold & Report",
      "description": "When SCOUT01 battery falls below the 20% critical threshold, immediately halt active exploration and report battery status without inventing unverified return routes or violating the <=20% movement lock.",
      "supported_event_types": ["VEHICLE_LOW_BATTERY"],
      "priority": 100,
      "cooldown_sec": 15.0,
      "operator_intervention_required": true,
      "preconditions": {
        "requires_active_mission": true,
        "requires_vehicle_online": false,
        "max_battery_pct": 20.0,
        "min_battery_pct": null,
        "requires_world_evidence": false,
        "requires_route_blocked": false
      },
      "required_evidence": ["vehicle_battery_telemetry"],
      "response_template": {
        "branch": "critical_battery",
        "rationale_prefix": "USED CACHED PLAN — Standing Order SO-01-CRITICAL-BATTERY:",
        "tasks": [
          {
            "id": "T-SAFE-01",
            "vehicle": "SCOUT01",
            "type": "STOP",
            "area": null,
            "target": null,
            "priority": 1
          },
          {
            "id": "T-SAFE-02",
            "vehicle": "SCOUT01",
            "type": "REPORT",
            "area": null,
            "target": null,
            "priority": 2
          }
        ]
      }
    },
    {
